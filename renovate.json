{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":automergeMinor",
    ":automergeBranch"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "infrastructure/networking/cilium/base/release.yaml"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "matchFileNames": [
        "infrastructure/storage/democratic-csi/app/release.yaml"
      ],
      "groupName": "democratic-csi images",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "external-secrets",
        "external-secrets-crds"
      ],
      "groupName": "external-secrets operator and CRDs",
      "automerge": false
    }
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "commitMessageExtra": "from {{{displayFrom}}} to {{{displayTo}}}",
  "ignoreTests": true,
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/\\.yaml(?:\\.j2)?$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml(?:\\.j2)?$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/infrastructure/storage/democratic-csi/app/release\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+tag: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "docker"
    }
  ]
}
